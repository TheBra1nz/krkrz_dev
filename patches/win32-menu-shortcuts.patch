diff --git a/Main.cpp b/Main.cpp
--- a/Main.cpp
+++ b/Main.cpp
@@ -141,20 +141,44 @@
 	keycodeToTextList = TJSCreateArrayObject();
 	if( textToKeycodeMap == NULL || keycodeToTextList == NULL ) return;
 
-	TCHAR tempKeyText[32];
-	for( int key = 8; key <= 255; key++ ) {
-		int code = (::MapVirtualKey( key, 0 )<<16)|(1<<25);
-		if( ::GetKeyNameText( code, tempKeyText, 32 ) > 0 ) {
-			ttstr text(tempKeyText);
-			// NumPadキー特殊処理
-			if( TJS_strnicmp(text.c_str(), TJS_W("Num "), 4) == 0 ) {
-				bool numpad = ( key >= VK_NUMPAD0 && key <= VK_DIVIDE );
-				if( !numpad && ::GetKeyNameText( code|(1<<24), tempKeyText, 32 ) > 0 ) {
-					text = tempKeyText;
-				}
-			}
-			SetShortCutKeyCode(text, key, true);
-		}
+	static constexpr LONG extendedKeyFlag = 1L << 24;
+	static constexpr LONG ignoreKeySideFlag = 1L << 25;
+	static constexpr int keyNameSize = 32;
+	TCHAR keyText[keyNameSize];
+	TCHAR ordinaryKeyText[keyNameSize];
+
+	for (int key = 8; key <= 255; ++key) {
+		const UINT scanCode = ::MapVirtualKey(key, MAPVK_VK_TO_VSC_EX);
+		if (scanCode == 0) continue;
+
+		// Pause uses scan code 0x45 in keyboard messages. Num Lock uses the
+		// extended key name for that scan code.
+		const bool isPause = key == VK_PAUSE;
+		const UINT messageScanCode = isPause ? 0x45 : (scanCode & 0xff);
+		LONG code = static_cast<LONG>(messageScanCode << 16) | ignoreKeySideFlag;
+		if (!isPause && ((scanCode & 0xff00) == 0xe000 || key == VK_NUMLOCK))
+			code |= extendedKeyFlag;
+
+		if (::GetKeyNameText(code, keyText, keyNameSize) <= 0) continue;
+		ttstr text(keyText);
+
+		// Preserve the navigation-key fallback for keypad-style names.
+		if (!(code & extendedKeyFlag) && (key < VK_NUMPAD0 || key > VK_DIVIDE) &&
+			TJS_strnicmp(text.c_str(), TJS_W("Num "), 4) == 0 &&
+			::GetKeyNameText(code | extendedKeyFlag, keyText, keyNameSize) > 0) {
+			code |= extendedKeyFlag;
+			text = keyText;
+		}
+
+		// A layout without a distinct extended name may return the ordinary
+		// key's name. Leave that name with the ordinary key. Ctrl and Alt
+		// intentionally share names between sides (bit 25).
+		if ((code & extendedKeyFlag) && key != VK_RCONTROL && key != VK_RMENU &&
+			::GetKeyNameText(code & ~extendedKeyFlag, ordinaryKeyText, keyNameSize) > 0 &&
+			TJS_stricmp(text.c_str(), ordinaryKeyText) == 0)
+			continue;
+
+		SetShortCutKeyCode(text, key, true);
 	}
 
