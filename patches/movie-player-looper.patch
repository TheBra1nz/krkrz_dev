@@ -86,17 +92,37 @@ MessageLooper::AddMessage(Message &&msg, bool flush)
 {
   std::lock_guard<std::mutex> lk(mMessageMutex);
 
+  // The worker can still post while its owner is waiting in QuitLoop().
+  if (mQuitRequested) {
+    return;
+  }
   if (flush) {
     // std::queue には clear() がない
     mMessageQueue = {};
   }
   mMessageQueue.push(msg);
+  mQuitRequested = msg.quit;
   mMessageCond.notify_all();
 #if defined(_WIN32)
   if (mWakeEvent) ::SetEvent((HANDLE)mWakeEvent);
 #endif
 }
 
+void
+MessageLooper::RemoveMessages(std::initializer_list<int32_t> types)
+{
+  std::lock_guard<std::mutex> lk(mMessageMutex);
+  std::queue<Message> retained;
+  while (!mMessageQueue.empty()) {
+    const Message &msg = mMessageQueue.front();
+    if (msg.quit || std::find(types.begin(), types.end(), msg.what) == types.end()) {
+      retained.push(msg);
+    }
+    mMessageQueue.pop();
+  }
+  mMessageQueue.swap(retained);
+}
