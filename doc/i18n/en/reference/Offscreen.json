{
  "class": "Offscreen",
  "entries": {
    "Offscreen": {
      "hash": "e9dd3ce9046a",
      "ja": {
        "description": "オフスクリーン。\nいわゆるレンダーターゲット。テクスチャとしても利用可能です。\n内部的に FBO, Renderbuffer, Texture が生成されます。\nレンダーターゲットとして設定しないのであれば、わざわざこのクラスを使用する必要性はありません。\nTextureクラスを使用した方がメモリ効率が良いです。"
      }
    },
    "Offscreen.Offscreen": {
      "hash": "62c168183983",
      "ja": {
        "summary": "オフスクリーンを生成。",
        "description": "破棄はinvalidate時に行われるので、不要になったら明示的なinvalidate推奨します。",
        "params": {
          "width": "オフスクリーン幅",
          "height": "オフスクリーン高さ"
        }
      }
    },
    "Offscreen.copyRect": {
      "hash": "733d218e57b1",
      "ja": {
        "summary": "矩形コピー",
        "params": {
          "dleft": "コピー先左端",
          "dtop": "コピー先上端",
          "src": "Bitmapクラスのオブジェクト",
          "srcRect": "srcのコピー元矩形"
        }
      }
    },
    "Offscreen.copyRect@2": {
      "hash": "82a3f6da87d5",
      "ja": {
        "summary": "矩形コピー",
        "params": {
          "dleft": "コピー先左端",
          "dtop": "コピー先上端",
          "src": "Bitmapクラスのオブジェクト",
          "sleft": "コピー元左端位置",
          "stop": "コピー元上端位置",
          "swidth": "コピー元幅",
          "sheight": "コピー元高さ"
        }
      }
    },
    "Offscreen.copyTo": {
      "hash": "6fc1bebaf2c5",
      "ja": {
        "summary": "Bitmapにコピー",
        "params": {
          "destBitmap": "格納先ビットマップ",
          "dleft": "コピー先左端",
          "dtop": "コピー先上端",
          "sleft": "コピー元左端",
          "stop": "コピー元上端",
          "width": "サイズ横幅",
          "height": "サイズ縦幅"
        }
      }
    },
    "Offscreen.copyTo@2": {
      "hash": "1550de2cb6e9",
      "ja": {
        "summary": "Bitmapにコピー",
        "description": "BitmapはOffscreenのサイズに合わせて拡大縮小されます。",
        "params": {
          "destBitmap": "格納先ビットマップ"
        }
      }
    },
    "Offscreen.copyTo@3": {
      "hash": "033511cd7bc3",
      "ja": {
        "summary": "Bitmapにコピー",
        "params": {
          "destBitmap": "格納先ビットマップ",
          "dleft": "コピー先左端",
          "dtop": "コピー先上端",
          "srcRect": "コピー元矩形"
        }
      }
    },
    "Offscreen.exchangeTexture": {
      "hash": "7f0b7afb833d",
      "ja": {
        "summary": "フレームバッファに設定されているテクスチャとTextureクラスが指すテクスチャを入れ替える。",
        "description": "交換するテクスチャのサイズは合わせておかないと例外となる。\nカラーフォーマットもRGBAとする必要がある。\nレンダリング途中での入れ替えも行わない方がいいかもしれない(要確認)。\nクロスフェードなどで両方に描画する必要がない場合、以前の画像をTextureとして取り出し、新しいTextureに差し替えることでオーバーヘッドを減らせる。",
        "params": {
          "texture": "交換するTextureクラスのインスタンス。"
        }
      }
    },
    "Offscreen.width": {
      "hash": "cdaf870e39aa",
      "ja": {
        "summary": "幅、生成時に指定されたもの[r]"
      }
    },
    "Offscreen.height": {
      "hash": "b61cbba9121f",
      "ja": {
        "summary": "高さ、生成時に指定されたもの[r]"
      }
    },
    "Offscreen.nativeHandle": {
      "hash": "21f1cec5a3f8",
      "ja": {
        "summary": "環境依存のハンドル[r]",
        "description": "OpenGL ES下ではtexture idとなる。"
      }
    }
  }
}
