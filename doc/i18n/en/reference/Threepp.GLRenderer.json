{
  "class": "Threepp.GLRenderer",
  "entries": {
    "krkrthreepp:Threepp.GLRenderer": {
      "hash": "74f22ef6ff9c",
      "ja": {
        "summary": "OpenGL レンダラー",
        "description": "シーンをレンダリングするためのレンダラーです。"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.GLRenderer": {
      "hash": "907743c27aaa",
      "ja": {
        "summary": "コンストラクタ",
        "description": "ホストが用意した GL コンテキスト上に描画するレンダラー(デバイス)。\n第1引数にホストの GL コンテキスト提供オブジェクト(gles プラグインの\nGLESAdaptor 等、GLGetProcAddress プロパティを持つもの)を渡すと、そこから\n関数ポインタ(getProcAddress)を取得して glad を初期化する。\nこれは effekseer / motion プラグインの Device と同じ結線方式。",
        "params": {
          "adaptor": "GL コンテキスト提供オブジェクト (GLGetProcAddress を持つ)",
          "width": "レンダリング幅",
          "height": "レンダリング高さ"
        }
      }
    },
    "krkrthreepp:Threepp.GLRenderer.GLRenderer@2": {
      "hash": "f8c9f5a907c8",
      "ja": {
        "summary": "コンストラクタ (従来形式)",
        "description": "GL コンテキストの current 化と glad の初期化を呼び出し側で\n済ませてある場合はこちら。ヘッドレス生成。"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.autoClear": {
      "hash": "7b62bc340613",
      "ja": {
        "summary": "自動クリアするか"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.autoClearColor": {
      "hash": "47923c76be7b",
      "ja": {
