        "summary": "オブジェクトをソートするか"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.useLegacyLights": {
      "hash": "ea1563c25f92",
      "ja": {
        "summary": "旧来ライティング(true)か物理的に正確(false, 既定)か"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.toneMappingExposure": {
      "hash": "a45d6eb54d0b",
      "ja": {
        "summary": "トーンマッピングの露出"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.onBeginScene": {
      "hash": "519abe98aa11",
      "ja": {
        "summary": "フレーム描画開始 (ホスト GL コンテキストが current な状態で呼ぶ)",
        "description": "内部ステートキャッシュを無効化し、描画サイズを設定する。\nadaptor.capture() のコールバック内で render() の前に呼ぶ。",
        "params": {
          "width": "サーフェス幅",
          "height": "サーフェス高さ"
        }
      }
    },
    "krkrthreepp:Threepp.GLRenderer.onEndScene": {
      "hash": "80beec6b585d",
      "ja": {
        "summary": "フレーム描画終了",
        "description": "render() 後に呼ぶ。現状は特別な処理を行わないが、ホストとの\nGL ステート整合のために呼び出し位置を確保しておく。"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.render": {
      "hash": "e7a2170749e8",
      "ja": {
        "summary": "シーンをレンダリング",
        "params": {
          "scene": "シーン",
          "camera": "カメラ"
        }
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setClearColor": {
      "hash": "8336f05a945a",
      "ja": {
        "summary": "クリアカラーを設定",
        "params": {
          "color": "色 (0xRRGGBB)",
          "alpha": "アルファ値"
        }
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setPixelRatio": {
      "hash": "ae91179caba9",
      "ja": {
        "summary": "ピクセル比を設定"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setSize": {
      "hash": "2fde7dd8579f",
      "ja": {
        "summary": "サイズを設定"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setSampleCount": {
      "hash": "ebb675938d7d",
      "ja": {
        "summary": "MSAA (マルチサンプルアンチエイリアス) のサンプル数を設定",
        "params": {
          "count": "0/1=無効, 2/4/8 など。既定 4。onBeginScene が内部マルチサンプル FBO へ\n描き onEndScene で解決(resolve)してホスト FBO へ転送する。輪郭のジャギーが軽減される。\n縁の premultiplied alpha が気になる場合はホスト側(GLESAdaptor.unpremultiply)で補正する。"
        }
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setScissorTest": {
      "hash": "3206abf2d204",
      "ja": {
        "summary": "シザーテストの有効/無効"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setShadowMapEnabled": {
      "hash": "2de7d3bea499",
      "ja": {
        "summary": "影(ShadowMap)の有効/無効",
        "description": "true でシャドウマップ描画を有効化する。別途、影を落とすライトの\ncastShadow=true・影を受けるメッシュの receiveShadow=true・影を落とすメッシュの\ncastShadow=true が必要。GLES/捕捉FBO 経路でも動作する(影用 FBO へ深度を焼き、\n本描画時に元の描画先へ復帰する)。\n使用例:\nrenderer.setShadowMapEnabled(true);\nvar dir = new Threepp.DirectionalLight(0xffffff, 2.0);\ndir.setPosition(3, 5, 2); dir.castShadow = true;\ndir.setShadowOrthoBounds(-6, 6, 6, -6); dir.setShadowNearFar(0.5, 30);\nscene.add(dir);\nfloor.receiveShadow = true; box.castShadow = true;"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setShadowMapType": {
      "hash": "1f65097b9452",
      "ja": {
        "summary": "0=Basic,1=PCF(既定),2=PCFSoft,3=VSM 相当"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setShadowMapAutoUpdate": {
      "hash": "15c5ce94a50e",
      "ja": {
        "summary": "毎フレーム影を更新(既定 true)"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.setShadowMapNeedsUpdate": {
      "hash": "fd3402f586f3",
      "ja": {
        "summary": "autoUpdate=false 時に1回だけ更新"
      }
    },
