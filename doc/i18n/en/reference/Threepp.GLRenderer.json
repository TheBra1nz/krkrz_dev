    },
    "krkrthreepp:Threepp.GLRenderer.autoClearDepth": {
      "hash": "a52930c12ab0",
      "ja": {
        "summary": "深度バッファを自動クリアするか"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.autoClearStencil": {
      "hash": "389565c268b0",
      "ja": {
        "summary": "ステンシルバッファを自動クリアするか"
      }
    },
    "krkrthreepp:Threepp.GLRenderer.sortObjects": {
      "hash": "c8d1c7325e62",
