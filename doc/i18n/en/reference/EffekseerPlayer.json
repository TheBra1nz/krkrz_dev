        "summary": "画面内回転。角度が正のとき画面上では時計回り。"
      }
    },
    "krkreffekseer:EffekseerPlayer.angle": {
      "hash": "7c00b30f2895",
      "ja": {
        "summary": "度"
      }
    },
    "krkreffekseer:EffekseerPlayer.setRotate": {
      "hash": "85666b2cc872",
      "ja": {
        "summary": "3軸回転(度)。z は setAngleDeg と同じ画面内回転。",
        "description": "x / y は奥行き方向の傾きで、透視投影と組み合わせると効果が分かりやすい。"
      }
    },
    "krkreffekseer:EffekseerPlayer.getRotate": {
      "hash": "4ec0a26524b0",
      "ja": {
        "summary": "%[ x:, y:, z: ]"
      }
    },
    "krkreffekseer:EffekseerPlayer.setSpeed": {
      "hash": "493d796f31e2",
      "ja": {
        "summary": "再生速度 (1.0 が等速)"
      }
    },
    "krkreffekseer:EffekseerPlayer.color": {
      "hash": "b9c982c164f5",
      "ja": {
        "summary": "全体色 0xAARRGGBB (既定 0xFFFFFFFF)。エフェクト全体に乗算される。"
      }
    },
    "krkreffekseer:EffekseerPlayer.paused": {
      "hash": "e0d87997a9f7",
      "ja": {
        "summary": "一時停止"
      }
    },
    "krkreffekseer:EffekseerPlayer.shown": {
      "hash": "18b878eda495",
      "ja": {
        "summary": "表示/非表示"
      }
    },
    "krkreffekseer:EffekseerPlayer.spawnDisabled": {
      "hash": "9fb843f8c4a4",
      "ja": {
        "summary": "新規パーティクル生成の停止"
      }
    },
    "krkreffekseer:EffekseerPlayer.layer": {
      "hash": "120d6227e94c",
      "ja": {
        "summary": "所属レイヤー (0〜31)"
      }
    },
    "krkreffekseer:EffekseerPlayer.setTargetLocation": {
      "hash": "7b8992d0b626",
      "ja": {
        "summary": "ターゲット位置 (エフェクト側で「ターゲット依存」を使っている場合)",
        "description": "座標は配置と同じ画面中央原点のピクセル座標。"
      }
    },
    "krkreffekseer:EffekseerPlayer.setRandomSeed": {
      "hash": "b7720086c6cf",
      "ja": {
        "summary": "乱数シードを固定する"
      }
    },
    "krkreffekseer:EffekseerPlayer.setDynamicInput": {
      "hash": "a258cb0bf1a4",
      "ja": {
        "summary": "動的パラメータ (Effekseer エディタの Dynamic Input)",
        "params": {
          "index": "エフェクト側で定義された動的入力の番号 (0 始まり)\n範囲外の index は無視される (取得は 0 を返す)。"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.setDynamicInputByName": {
      "hash": "87d2a5a71f07",
      "ja": {
        "summary": "動的パラメータを名前で差し込む / 読む",
        "description": "対応は .efkzip の effect.json から自動で入る\n(EffekseerEffect.setDynamicInputNames() で差し替えもできる)。\n知らない名前を渡すと例外。\n\nplayer.setDynamicInputByName(\"emitter.x\", 120);"
      }
    },
    "krkreffekseer:EffekseerPlayer.findDynamicInput": {
      "hash": "9c5a5cd28489",
      "ja": {
        "summary": "差し込める名前かどうかの確認。知らなければ -1"
      }
    },
    "krkreffekseer:EffekseerPlayer.meta": {
      "hash": "66a7ff053abb",
      "ja": {
        "summary": "再生している素材の付属情報 (EffekseerEffect.meta と同じもの)",
        "description": "player.load() で読んだ場合も触れるよう橋渡ししてある。"
      }
    },
    "krkreffekseer:EffekseerPlayer.sendTrigger": {
      "hash": "e987bd1239f2",
      "ja": {
        "summary": "トリガー送出 (Effekseer エディタの Trigger)",
        "params": {
          "index": "エフェクト側で定義されたトリガーの番号 (0 始まり)"
        }
      }
    }
  }
}
