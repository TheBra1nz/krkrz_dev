        "summary": "コンストラクタ",
        "params": {
          "device": "EffekseerDevice インスタンス"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.device": {
      "hash": "592334de1581",
      "ja": {
        "summary": "読み出し専用"
      }
    },
    "krkreffekseer:EffekseerPlayer.effect": {
      "hash": "6eaad9d7b115",
      "ja": {
        "summary": "読み出し専用: loadEffect() で割り当てた EffekseerEffect"
      }
    },
    "krkreffekseer:EffekseerPlayer.load": {
      "hash": "c70b39d69a3c",
      "ja": {
        "summary": "エフェクトファイルを読み込む (このプレイヤー専用)",
        "description": "引数は EffekseerEffect.load と同じ (.efkzip 対応)",
        "params": {
          "filename": "ストレージ名 (.efkzip / .efkefc / .efk)",
          "magnification": "読み込み時の拡大率 (省略時 1.0)",
          "entry": ".efkzip 内のエフェクトファイル名 (省略可)"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.loadEffect": {
      "hash": "19deab6a8319",
      "ja": {
        "summary": "読み込み済みの EffekseerEffect を割り当てる",
        "params": {
          "effect": "EffekseerEffect インスタンス"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.clear": {
      "hash": "87e1631e36d0",
      "ja": {
        "summary": "割り当て解除 (再生中なら停止する)"
      }
    },
    "krkreffekseer:EffekseerPlayer.loaded": {
      "hash": "592334de1581",
      "ja": {
        "summary": "読み出し専用"
      }
    },
    "krkreffekseer:EffekseerPlayer.play": {
      "hash": "8cf681bb8244",
      "ja": {
        "summary": "再生開始。再生中の場合はいったん停止してから再スタートする。",
        "params": {
          "startFrame": "開始フレーム (省略時 0)"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.stop": {
      "hash": "b0b50a4675d0",
      "ja": {
        "summary": "即時停止 (パーティクルも消える)"
      }
    },
    "krkreffekseer:EffekseerPlayer.stopRoot": {
      "hash": "0bfdc6c57da3",
      "ja": {
        "summary": "ルートのみ停止。新規パーティクルの生成を止め、残りは自然消滅させる。",
        "description": "「エフェクトを綺麗に終わらせる」場合はこちら。"
      }
    },
    "krkreffekseer:EffekseerPlayer.progress": {
      "hash": "0aecf31a40a9",
      "ja": {
        "summary": "進行",
        "params": {
          "tick": "経過時間(ミリ秒)\n配置系の設定は progress() より前に行うこと。"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.moveToFrame": {
      "hash": "4e7c1441c4b5",
      "ja": {
