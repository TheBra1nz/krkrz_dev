      }
    },
    "krkreffekseer:EffekseerPlayer.getRenderMatrix": {
      "hash": "72627e15f15a",
      "ja": {
        "summary": "%[ m11:, m12:, m13:, m21:, m22:, m23: ]"
      }
    },
    "krkreffekseer:EffekseerPlayer.setRenderScale": {
      "hash": "03ea610b035f",
      "ja": {
