        "summary": "%[ x:, y:, z: ]"
      }
    },
    "krkreffekseer:EffekseerPlayer.setZoom": {
      "hash": "ffdaacd0076f",
      "ja": {
        "summary": "拡縮 (既定 1.0)"
      }
    },
    "krkreffekseer:EffekseerPlayer.getZoom": {
      "hash": "b9f27a3b658b",
      "ja": {
        "summary": "%[ x:, y: ]"
      }
    },
