{
  "class": "EffekseerPlayer",
  "entries": {
    "krkreffekseer:EffekseerPlayer": {
      "hash": "6e97db2dad8b",
      "ja": {
        "summary": "再生用プレイヤー",
        "description": "エフェクト 1 インスタンスの再生・配置・描画を担当する。"
      }
    },
    "krkreffekseer:EffekseerPlayer.EffekseerPlayer": {
      "hash": "05ad90beed89",
