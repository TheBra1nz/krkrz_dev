          "frame": "フレーム数 (60fps基準)"
        }
      }
    },
    "krkreffekseer:EffekseerPlayer.render": {
      "hash": "5823e6a619fb",
      "ja": {
        "summary": "描画。OpenGL コンテキスト上で、device.onBeginScene()〜onEndScene() の間で呼ぶ。"
      }
