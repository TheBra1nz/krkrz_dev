Preserve the displayed WebM frame when playback finishes or stops.

Apply in krkrz_dev/src/core/external/movie-player, then rebuild the engine.
Base movie-player commit: 7b9ded9bcd7c5fb1c1dacb714476ae2a2f69cc51
Referenced by krkrz core commit: cbd262d1f4811903e5a30818c3b6a7c2593e31c7

MSG_FINISH and MSG_STOP previously presented mDummyFrame without updating it.
The saved image could be the first frame captured by Play -> Seek -> Flush.
Refresh the saved buffer from the current frame before releasing the decoder
buffer. The existing state notifications, queue flush, and event flags remain.

Validation: an isolated C++ check using the production stop/finish cases,
frame-publication methods, and buffer-copy implementation reproduced the old
image with the original source and passed with this patch. Decoder and message
transport were test doubles. Full decoding and game playback were not tested.

diff --git a/src/windows/MoviePlayerCore.cpp b/src/windows/MoviePlayerCore.cpp
--- a/src/windows/MoviePlayerCore.cpp
+++ b/src/windows/MoviePlayerCore.cpp
@@ -756,6 +756,10 @@
   } break;
 
   case MSG_STOP:
+    // Keep the displayed image when releasing its decoder-owned buffer.
+    if (mVideoFrame && mVideoFrame != &mDummyFrame) {
+      mDummyFrame.CopyFrom(mVideoFrame, false);
+    }
     SetVideoFrame(&mDummyFrame);
     SetState(STATE_STOP);
     Post(MSG_NOP, 0, nullptr, true); // flush msg
@@ -763,6 +767,11 @@
     break;
 
   case MSG_FINISH:
+    // The dummy frame may still contain the image saved by an earlier seek.
+    // Refresh it before presenting it, so EOF does not flash that old image.
+    if (mVideoFrame && mVideoFrame != &mDummyFrame) {
+      mDummyFrame.CopyFrom(mVideoFrame, false);
+    }
     SetVideoFrame(&mDummyFrame);
     SetState(STATE_FINISH);
     Post(MSG_NOP, 0, nullptr, true); // flush msg
